   "source": [
    "Generate an image for the FOPDT Equation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e41580e9",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "CairoMakie.Screen{SVG}\n"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "using CairoMakie, LaTeXStrings\n",
    "CairoMakie.activate!(type = \"svg\")\n",
    "\n",
    "fig = Figure(size = (420, 110), backgroundcolor = :transparent)\n",
    "Label(fig[1, 1], L\"g(s) = \\frac{k\\,e^{-\\theta s}}{\\tau s + 1}\", fontsize = 44)\n",
    "save(\"fopdt_eq.svg\", fig)"
   ]
  }
